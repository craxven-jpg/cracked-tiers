const {
    SlashCommandBuilder,
    EmbedBuilder
} = require("discord.js");

const Player = require("../models/Player");

module.exports = {
    data: new SlashCommandBuilder()
        .setName("register")
        .setDescription("Register yourself in Cracked Tiers"),

    async execute(interaction) {

        const user = interaction.user;

        const exists = await Player.findOne({
            userId: user.id
        });

        if (exists) {
            return interaction.reply({
                content: "❌ You are already registered.",
                ephemeral: true
            });
        }

        const player = new Player({
            userId: user.id,
            username: user.username,
            elo: 1000,
            wins: 0,
            losses: 0,
            matches: 0,
            tier: "Unranked",
            registeredAt: new Date()
        });

        await player.save();

        const embed = new EmbedBuilder()
            .setColor("#8A2BE2")
            .setTitle("✅ Registration Successful")
            .setThumbnail(user.displayAvatarURL())
            .setDescription(
                `Welcome to **Cracked Tiers**, ${user}!`
            )
            .addFields(
                {
                    name: "🏆 Tier",
                    value: "Unranked",
                    inline: true
                },
                {
                    name: "⭐ ELO",
                    value: "1000",
                    inline: true
                },
                {
                    name: "🎮 Matches",
                    value: "0",
                    inline: true
                },
                {
                    name: "✅ Wins",
                    value: "0",
                    inline: true
                },
                {
                    name: "❌ Losses",
                    value: "0",
                    inline: true
                }
            )
            .setFooter({
                text: "Cracked Tiers"
            })
            .setTimestamp();

        interaction.reply({
            embeds: [embed]
        });

    }
};
