const mongoose = require("mongoose");

const playerSchema = new mongoose.Schema({

    userId: {
        type: String,
        required: true,
        unique: true
    },

    username: String,

    elo: {
        type: Number,
        default: 1000
    },

    wins: {
        type: Number,
        default: 0
    },

    losses: {
        type: Number,
        default: 0
    },

    matches: {
        type: Number,
        default: 0
    },

    tier: {
        type: String,
        default: "Unranked"
    },

    registeredAt: Date

});

module.exports = mongoose.model("Player", playerSchema);
